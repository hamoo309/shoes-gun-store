# TEMPLATE ONLY. Copy to a private .env.production on the target, outside backups
# sent for review. Do not replace the existing local .env or change any accounts.
# Read docs/PRODUCTION-PREPARATION.md and docs/BACKUP.md before operating a host.

# Exact reviewed image references. Use a unique release tag or registry digest;
# never reuse :latest or overwrite a release tag. These are placeholders.
API_IMAGE=registry.example.com/shoes-gun-api:REPLACE_WITH_REVIEWED_RELEASE
WEB_IMAGE=registry.example.com/shoes-gun-web:REPLACE_WITH_REVIEWED_RELEASE
# Record tested upstream references too, preferably digests. Keep PostgreSQL
# major version 16 for this transfer; a major upgrade is a separate operation.
POSTGRES_IMAGE=postgres:16.15-bookworm
CADDY_IMAGE=caddy:REPLACE_WITH_REVIEWED_VERSION_OR_DIGEST

# Hostname only; NEXT_PUBLIC_SITE_URL must be its exact HTTPS origin, no path.
DOMAIN=shop.example.com
ACME_EMAIL=REPLACE_WITH_CERTIFICATE_CONTACT_EMAIL
NEXT_PUBLIC_SITE_URL=https://shop.example.com
# Choose a private subnet with no overlap on the target host/VPN. The fixed
# Caddy address must belong to it; API trusts only this peer, not a hop count.
STORE_NETWORK_SUBNET=172.30.0.0/24
CADDY_PROXY_IP=172.30.0.10

# PostgreSQL bootstrap identity for a NEW target volume. Existing volumes retain
# their current credentials; changing these variables does not rotate a password.
POSTGRES_DB=shoes_gun
POSTGRES_USER=shoesgun_owner
POSTGRES_PASSWORD=REPLACE_PRIVATELY_WITH_TARGET_DATABASE_PASSWORD
# Explicit target, with URI-encoded user/password. For a restore, use a NEW empty
# database created as documented; set this name before any migration/application.
# Example target name only; do not point a rehearsal at the original database.
DATABASE_URL=postgresql://shoesgun_app:URI_ENCODED_RUNTIME_PASSWORD@db:5432/shoes_gun_restore_YYYYMMDD?schema=public
# Migration/restore owner only; never expose this identity to the API runtime.
MIGRATION_DATABASE_URL=postgresql://shoesgun_owner:URI_ENCODED_OWNER_PASSWORD@db:5432/shoes_gun_restore_YYYYMMDD?schema=public

# Preserve the original value exactly from the private secret store. It is also
# used for customer order links when APP_SECRET is absent. Do not regenerate it.
SESSION_SECRET=RESTORE_ORIGINAL_SESSION_SECRET_PRIVATELY
# If the source uses APP_SECRET, preserve that exact value as well (it takes
# precedence for order links). Otherwise leave this unset, as on the source.
# APP_SECRET=RESTORE_ORIGINAL_APP_SECRET_PRIVATELY

# Enforced by Compose for public production; no HTTP preview exception here.
COOKIE_SECURE=true
ALLOW_INSECURE_LOCAL_PREVIEW=false
LOGIN_RATE_LIMIT_STORE=postgres
# API storage is the named media_data volume at /app/storage. Both products/ and
# private/ are required; never mount private/ under a public web directory.
