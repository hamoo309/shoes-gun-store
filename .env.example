# Run npm run setup to generate a private local password and session secret.
DATABASE_URL=postgresql://shoesgun:CHANGE_ME@127.0.0.1:55432/shoes_gun?schema=public
PORT=4000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
NODE_ENV=development
# Set false only for local HTTP production preview. HTTPS production uses true.
COOKIE_SECURE=false
STORAGE_DIR=./storage
API_INTERNAL_URL=http://127.0.0.1:4000
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
