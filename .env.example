# Development template for a NEW disposable local store only.
# Existing store: preserve its database, media, accounts, and original secret.
# Never run setup/seed/reset as part of moving or upgrading an existing store.
DATABASE_URL=postgresql://shoesgun:CHANGE_ME@127.0.0.1:55432/shoes_gun?schema=public
PORT=4000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
NODE_ENV=development
LOGIN_RATE_LIMIT_STORE=memory
# Set false only for local HTTP production preview. HTTPS production uses true.
COOKIE_SECURE=false
# Required only when running a production build over HTTP on loopback.
# ALLOW_INSECURE_LOCAL_PREVIEW=true
STORAGE_DIR=./storage
API_INTERNAL_URL=http://127.0.0.1:4000
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public production: use .env.production.example and preserve the current secret.
# Never copy secrets into NEXT_PUBLIC_* variables, web build arguments, or client code.
# Optional: PostgreSQL's bin directory for the isolated local dev cluster.
# PG_BIN=C:/Program Files/PostgreSQL/16/bin
