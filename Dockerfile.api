FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci --include=dev
COPY apps/api ./apps/api
COPY apps/web/public ./apps/web/public
COPY scripts/init-media.mjs ./scripts/init-media.mjs
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
RUN npm run db:generate --workspace @shoes-gun/api && npm run build --workspace @shoes-gun/api
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4000 STORAGE_DIR=/app/storage
RUN mkdir -p /app/storage/products /app/storage/private && chown -R node:node /app
USER node
EXPOSE 4000
CMD ["node", "apps/api/dist/server.js"]
